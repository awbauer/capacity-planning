{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capacity-planning",
  "compatibility_date": "2026-10-07",
  "main": "./worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  // No static assets: the Worker serves the app itself (worker/assets.ts), so Cloudflare
  // Access's ctx.access reaches it. In development the Vite dev server serves the app.
  // The shared workspace (on by default per browser). Each plan is one PlanRoom; Workspace
  // holds people, roles, the plan list and the activity log. Both use SQLite storage.
  "durable_objects": {
    "bindings": [
      { "name": "PLAN_ROOM", "class_name": "PlanRoom" },
      { "name": "WORKSPACE", "class_name": "Workspace" }
    ]
  },
  "exports": {
    "PlanRoom": { "type": "durable-object", "storage": "sqlite" },
    "Workspace": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Cloudflare Email Service, for emailing people when they're @mentioned. Nothing is
  // sent until MAIL_FROM and APP_URL are set; see README "Comments and mentions".
  "send_email": [{ "name": "EMAIL" }],
  // No variables are needed. Optional ones (OWNER_EMAILS; MAIL_FROM and APP_URL for mention
  // emails) are set in the dashboard and kept across deploys; see README "Shared workspace".
  "keep_vars": true,
  // Preview deployments (Workers Builds on non-production branches) don't inherit bindings.
  // Each Preview gets its own, empty Durable Object storage (never production's data).
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "PLAN_ROOM", "class_name": "PlanRoom" },
        { "name": "WORKSPACE", "class_name": "Workspace" }
      ]
    },
    "send_email": [
      {
        "name": "EMAIL"
      }
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issue_detection": {
        "enabled": true
      }
    },
  }
}
